import domain.metric as dm

pub struct AggregateResult {
    count: Int
    total: Int
    min_val: Int
    max_val: Int
    average: Int
}

pub fn aggregate_samples(samples: [dm.MetricSample]) -> AggregateResult {
    if len(samples) == 0 {
        return AggregateResult {
            count: 0,
            total: 0,
            min_val: 0,
            max_val: 0,
            average: 0,
        }
    }

    var total = 0
    var min_v = samples[0].value
    var max_v = samples[0].value

    for s in samples {
        total = total + s.value
        if s.value < min_v {
            min_v = s.value
        }
        if s.value > max_v {
            max_v = s.value
        }
    }

    let avg = total / len(samples)

    AggregateResult {
        count: len(samples),
        total: total,
        min_val: min_v,
        max_val: max_v,
        average: avg,
    }
}
