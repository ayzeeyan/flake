import domain.record as rec

pub fn summarize_record(record: rec.Record) -> String {
    let status_str = match record.status {
        rec.Status.Pending => "pending"
        rec.Status.Processed(score) => "processed(score: {score})"
        rec.Status.Failed(reason) => "failed({reason})"
    }
    "[{record.id}] {record.category}: {status_str}"
}
