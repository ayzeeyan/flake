// Benchmark: nbody
// Models the orbits of the Jovian planets using a symplectic integrator.

fn sqrt_approx(val: Float) -> Float {
    if val <= 0.0 {
        return 0.0
    }
    var x = val
    var i = 0
    while i < 20 {
        x = 0.5 * (x + val / x)
        i = i + 1
    }
    x
}

fn offset_momentum(vx: [Float], vy: [Float], vz: [Float], mass: [Float], solar_mass: Float) {
    var px = 0.0
    var py = 0.0
    var pz = 0.0
    var i = 0
    while i < 5 {
        px = px - vx[i] * mass[i]
        py = py - vy[i] * mass[i]
        pz = pz - vz[i] * mass[i]
        i = i + 1
    }
    vx[0] = px / solar_mass
    vy[0] = py / solar_mass
    vz[0] = pz / solar_mass
}

fn energy(x: [Float], y: [Float], z: [Float], vx: [Float], vy: [Float], vz: [Float], mass: [Float]) -> Float {
    var e = 0.0
    var i = 0
    while i < 5 {
        e = e + 0.5 * mass[i] * (vx[i] * vx[i] + vy[i] * vy[i] + vz[i] * vz[i])
        var j = i + 1
        while j < 5 {
            let dx = x[i] - x[j]
            let dy = y[i] - y[j]
            let dz = z[i] - z[j]
            let dist = sqrt_approx(dx * dx + dy * dy + dz * dz)
            e = e - (mass[i] * mass[j]) / dist
            j = j + 1
        }
        i = i + 1
    }
    e
}

fn advance(x: [Float], y: [Float], z: [Float], vx: [Float], vy: [Float], vz: [Float], mass: [Float], dt: Float) {
    var i = 0
    while i < 5 {
        var j = i + 1
        while j < 5 {
            let dx = x[i] - x[j]
            let dy = y[i] - y[j]
            let dz = z[i] - z[j]
            let d_sq = dx * dx + dy * dy + dz * dz
            let dist = sqrt_approx(d_sq)
            let mag = dt / (d_sq * dist)

            vx[i] = vx[i] - dx * mass[j] * mag
            vy[i] = vy[i] - dy * mass[j] * mag
            vz[i] = vz[i] - dz * mass[j] * mag

            vx[j] = vx[j] + dx * mass[i] * mag
            vy[j] = vy[j] + dy * mass[i] * mag
            vz[j] = vz[j] + dz * mass[i] * mag

            j = j + 1
        }
        i = i + 1
    }

    var k = 0
    while k < 5 {
        x[k] = x[k] + vx[k] * dt
        y[k] = y[k] + vy[k] * dt
        z[k] = z[k] + vz[k] * dt
        k = k + 1
    }
}

fn main() / io + alloc {
    var steps = 100
    let p_args = args()
    if len(p_args) > 0 {
        steps = int(p_args[0])
    }

    let pi = 3.141592653589793
    let solar_mass = 4.0 * pi * pi
    let days_per_year = 365.24

    // Initial bodies: Sun, Jupiter, Saturn, Uranus, Neptune
    var x: [Float] = [
        0.0,
        4.8414314424647209,
        8.34336671824457987,
        12.894369562139131,
        15.3796971148509165
    ]
    var y: [Float] = [
        0.0,
        -1.16032004402742839,
        4.12479856412430479,
        -15.1111514016986312,
        -25.9193146099879641
    ]
    var z: [Float] = [
        0.0,
        -0.103622044471123109,
        -0.403523417114321381,
        -0.223307578892655734,
        0.179258772950371181
    ]
    var vx: [Float] = [
        0.0,
        0.00166007664274403694 * days_per_year,
        -0.00276742510726862411 * days_per_year,
        0.00296460137564761618 * days_per_year,
        0.00268067772490389322 * days_per_year
    ]
    var vy: [Float] = [
        0.0,
        0.00769901118419740425 * days_per_year,
        0.00499852801234917238 * days_per_year,
        0.0023784717395948095 * days_per_year,
        0.00162824170038242295 * days_per_year
    ]
    var vz: [Float] = [
        0.0,
        -0.0000690460016972063023 * days_per_year,
        0.0000230417297573763929 * days_per_year,
        -0.0000296589568540237556 * days_per_year,
        -0.000095159225451971587 * days_per_year
    ]
    var mass: [Float] = [
        solar_mass,
        0.000954791938424326609 * solar_mass,
        0.000285885980666130812 * solar_mass,
        0.0000436624404335156298 * solar_mass,
        0.0000515138902046611451 * solar_mass
    ]

    offset_momentum(vx, vy, vz, mass, solar_mass)

    let e0 = energy(x, y, z, vx, vy, vz, mass)
    print("energy(start): {e0}")

    var s = 0
    while s < steps {
        advance(x, y, z, vx, vy, vz, mass, 0.01)
        s = s + 1
    }

    let e1 = energy(x, y, z, vx, vy, vz, mass)
    print("energy(end): {e1}")
}
