// Trait declarations, method signatures, implementations, bounds, and method dispatch.

trait Show {
    fn show(self) -> String
}

impl Show for Int {
    fn show(self) -> String {
        str(self)
    }
}

impl Show for String {
    fn show(self) -> String {
        self
    }
}

struct Pair[T: Eq] {
    left: T,
    right: T,
}

impl Show for Pair {
    fn show(self) -> String {
        "Pair({self.left}, {self.right})"
    }
}

fn max[T: Ord](a: T, b: T) -> T {
    if a > b {
        a
    } else {
        b
    }
}

fn same[T: Eq](a: T, b: T) -> Bool {
    a == b
}

fn display[T: Show](value: T) -> String {
    value.show()
}

fn main() / io {
    print(max(3, 9))
    print(max("alpha", "zeta"))
    print(same(7, 7))
    print(same("flake", "flake"))
    print(display(42))
    print(display("crystallized"))
    let p = Pair { left: 1, right: 2 }
    print(p.show())
}
