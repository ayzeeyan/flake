// Token kinds and Token struct for the Flake frontend.
import span

pub enum TokenKind {
    // Keywords
    KwFn
    KwLet
    KwVar
    KwStruct
    KwEnum
    KwTrait
    KwImpl
    KwType
    KwIf
    KwElse
    KwWhile
    KwFor
    KwLoop
    KwMatch
    KwReturn
    KwBreak
    KwContinue
    KwSpawn
    KwAwait
    KwNursery
    KwImport
    KwPub
    KwStrict
    KwOwned
    KwRef
    KwMut
    KwDyn
    KwTrue
    KwFalse
    KwNil
    KwAs
    KwTask

    // Literals & Identifiers
    IntLit(Int)
    FloatLit(Float)
    StringLit(String)
    Ident(String)

    // Symbols & Operators
    Plus          // +
    Minus         // -
    Star          // *
    Slash         // /
    Percent       // %
    Eq            // =
    EqEq          // ==
    NotEq         // !=
    Lt            // <
    LtEq          // <=
    Gt            // >
    GtEq          // >=
    AndAnd        // &&
    OrOr          // ||
    Bang          // !
    Question      // ?
    Dot           // .
    DotDot        // ..
    Comma         // ,
    Colon         // :
    Arrow         // ->
    FatArrow      // =>
    PlusEq        // +=
    MinusEq       // -=
    StarEq        // *=
    SlashEq       // /=
    PercentEq     // %=
    LParen        // (
    RParen        // )
    LBrace        // {
    RBrace        // }
    LBracket      // [
    RBracket      // ]

    // Special
    Eof
}

pub struct Token {
    kind: TokenKind,
    span: span.Span,
    text: String,
}

pub fn new_token(kind: TokenKind, span: span.Span, text: String) -> Token {
    Token {
        kind: kind,
        span: span,
        text: text,
    }
}

pub fn token_kind_name(kind: TokenKind) -> String {
    match kind {
        TokenKind.KwFn => "fn"
        TokenKind.KwLet => "let"
        TokenKind.KwVar => "var"
        TokenKind.KwStruct => "struct"
        TokenKind.KwEnum => "enum"
        TokenKind.KwTrait => "trait"
        TokenKind.KwImpl => "impl"
        TokenKind.KwType => "type"
        TokenKind.KwIf => "if"
        TokenKind.KwElse => "else"
        TokenKind.KwWhile => "while"
        TokenKind.KwFor => "for"
        TokenKind.KwLoop => "loop"
        TokenKind.KwMatch => "match"
        TokenKind.KwReturn => "return"
        TokenKind.KwBreak => "break"
        TokenKind.KwContinue => "continue"
        TokenKind.KwSpawn => "spawn"
        TokenKind.KwAwait => "await"
        TokenKind.KwNursery => "nursery"
        TokenKind.KwImport => "import"
        TokenKind.KwPub => "pub"
        TokenKind.KwStrict => "strict"
        TokenKind.KwOwned => "owned"
        TokenKind.KwRef => "ref"
        TokenKind.KwMut => "mut"
        TokenKind.KwDyn => "dyn"
        TokenKind.KwTrue => "true"
        TokenKind.KwFalse => "false"
        TokenKind.KwNil => "nil"
        TokenKind.KwAs => "as"
        TokenKind.KwTask => "Task"
        TokenKind.IntLit(n) => "Int({n})"
        TokenKind.FloatLit(f) => "Float({f})"
        TokenKind.StringLit(s) => "String(\"{s}\")"
        TokenKind.Ident(name) => "Ident({name})"
        TokenKind.Plus => "+"
        TokenKind.Minus => "-"
        TokenKind.Star => "*"
        TokenKind.Slash => "/"
        TokenKind.Percent => "%"
        TokenKind.Eq => "="
        TokenKind.EqEq => "=="
        TokenKind.NotEq => "!="
        TokenKind.Lt => "<"
        TokenKind.LtEq => "<="
        TokenKind.Gt => ">"
        TokenKind.GtEq => ">="
        TokenKind.AndAnd => "&&"
        TokenKind.OrOr => "||"
        TokenKind.Bang => "!"
        TokenKind.Question => "?"
        TokenKind.Dot => "."
        TokenKind.DotDot => ".."
        TokenKind.Comma => ","
        TokenKind.Colon => ":"
        TokenKind.Arrow => "->"
        TokenKind.FatArrow => "=>"
        TokenKind.PlusEq => "+="
        TokenKind.MinusEq => "-="
        TokenKind.StarEq => "*="
        TokenKind.SlashEq => "/="
        TokenKind.PercentEq => "%="
        TokenKind.LParen => "("
        TokenKind.RParen => ")"
        TokenKind.LBrace => "\{"
        TokenKind.RBrace => "\}"
        TokenKind.LBracket => "["
        TokenKind.RBracket => "]"
        TokenKind.Eof => "<eof>"
    }
}