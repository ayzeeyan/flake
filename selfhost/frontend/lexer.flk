// Lexer for Flake source files.
import span
import tokens
import result
import option

fn is_digit(c: String) -> Bool {
    c == "0" || c == "1" || c == "2" || c == "3" || c == "4" ||
    c == "5" || c == "6" || c == "7" || c == "8" || c == "9"
}

fn is_alpha(c: String) -> Bool {
    (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_"
}

fn is_alphanumeric(c: String) -> Bool {
    is_alpha(c) || is_digit(c)
}

fn keyword_or_ident(text: String) -> tokens.TokenKind {
    if text == "fn" { return tokens.TokenKind.KwFn }
    if text == "let" { return tokens.TokenKind.KwLet }
    if text == "var" { return tokens.TokenKind.KwVar }
    if text == "struct" { return tokens.TokenKind.KwStruct }
    if text == "enum" { return tokens.TokenKind.KwEnum }
    if text == "trait" { return tokens.TokenKind.KwTrait }
    if text == "impl" { return tokens.TokenKind.KwImpl }
    if text == "type" { return tokens.TokenKind.KwType }
    if text == "if" { return tokens.TokenKind.KwIf }
    if text == "else" { return tokens.TokenKind.KwElse }
    if text == "while" { return tokens.TokenKind.KwWhile }
    if text == "for" { return tokens.TokenKind.KwFor }
    if text == "loop" { return tokens.TokenKind.KwLoop }
    if text == "match" { return tokens.TokenKind.KwMatch }
    if text == "return" { return tokens.TokenKind.KwReturn }
    if text == "break" { return tokens.TokenKind.KwBreak }
    if text == "continue" { return tokens.TokenKind.KwContinue }
    if text == "spawn" { return tokens.TokenKind.KwSpawn }
    if text == "await" { return tokens.TokenKind.KwAwait }
    if text == "nursery" { return tokens.TokenKind.KwNursery }
    if text == "import" { return tokens.TokenKind.KwImport }
    if text == "pub" { return tokens.TokenKind.KwPub }
    if text == "strict" { return tokens.TokenKind.KwStrict }
    if text == "owned" { return tokens.TokenKind.KwOwned }
    if text == "ref" { return tokens.TokenKind.KwRef }
    if text == "mut" { return tokens.TokenKind.KwMut }
    if text == "dyn" { return tokens.TokenKind.KwDyn }
    if text == "true" { return tokens.TokenKind.KwTrue }
    if text == "false" { return tokens.TokenKind.KwFalse }
    if text == "nil" { return tokens.TokenKind.KwNil }
    if text == "as" { return tokens.TokenKind.KwAs }
    if text == "Task" { return tokens.TokenKind.KwTask }
    tokens.TokenKind.Ident(text)
}

fn scan_2char_op(source: String, pos: Int) -> option.Option[tokens.TokenKind] {
    if pos + 1 >= len(source) {
        return option.Option.None
    }
    let c1 = source[pos]
    let c2 = source[pos + 1]
    if c1 == "=" && c2 == "=" { return option.Option.Some(tokens.TokenKind.EqEq) }
    if c1 == "=" && c2 == ">" { return option.Option.Some(tokens.TokenKind.FatArrow) }
    if c1 == "!" && c2 == "=" { return option.Option.Some(tokens.TokenKind.NotEq) }
    if c1 == "<" && c2 == "=" { return option.Option.Some(tokens.TokenKind.LtEq) }
    if c1 == ">" && c2 == "=" { return option.Option.Some(tokens.TokenKind.GtEq) }
    if c1 == "&" && c2 == "&" { return option.Option.Some(tokens.TokenKind.AndAnd) }
    if c1 == "|" && c2 == "|" { return option.Option.Some(tokens.TokenKind.OrOr) }
    if c1 == "-" && c2 == ">" { return option.Option.Some(tokens.TokenKind.Arrow) }
    if c1 == "." && c2 == "." { return option.Option.Some(tokens.TokenKind.DotDot) }
    if c1 == "+" && c2 == "=" { return option.Option.Some(tokens.TokenKind.PlusEq) }
    if c1 == "-" && c2 == "=" { return option.Option.Some(tokens.TokenKind.MinusEq) }
    if c1 == "*" && c2 == "=" { return option.Option.Some(tokens.TokenKind.StarEq) }
    if c1 == "/" && c2 == "=" { return option.Option.Some(tokens.TokenKind.SlashEq) }
    if c1 == "%" && c2 == "=" { return option.Option.Some(tokens.TokenKind.PercentEq) }
    option.Option.None
}

fn scan_1char_op(c: String) -> option.Option[tokens.TokenKind] {
    if c == "+" { return option.Option.Some(tokens.TokenKind.Plus) }
    if c == "-" { return option.Option.Some(tokens.TokenKind.Minus) }
    if c == "*" { return option.Option.Some(tokens.TokenKind.Star) }
    if c == "/" { return option.Option.Some(tokens.TokenKind.Slash) }
    if c == "%" { return option.Option.Some(tokens.TokenKind.Percent) }
    if c == "=" { return option.Option.Some(tokens.TokenKind.Eq) }
    if c == "<" { return option.Option.Some(tokens.TokenKind.Lt) }
    if c == ">" { return option.Option.Some(tokens.TokenKind.Gt) }
    if c == "!" { return option.Option.Some(tokens.TokenKind.Bang) }
    if c == "?" { return option.Option.Some(tokens.TokenKind.Question) }
    if c == "." { return option.Option.Some(tokens.TokenKind.Dot) }
    if c == "," { return option.Option.Some(tokens.TokenKind.Comma) }
    if c == ":" { return option.Option.Some(tokens.TokenKind.Colon) }
    if c == "(" { return option.Option.Some(tokens.TokenKind.LParen) }
    if c == ")" { return option.Option.Some(tokens.TokenKind.RParen) }
    if c == "\{" { return option.Option.Some(tokens.TokenKind.LBrace) }
    if c == "\}" { return option.Option.Some(tokens.TokenKind.RBrace) }
    if c == "[" { return option.Option.Some(tokens.TokenKind.LBracket) }
    if c == "]" { return option.Option.Some(tokens.TokenKind.RBracket) }
    if c == "&" { return option.Option.Some(tokens.TokenKind.Amp) }
    if c == "|" { return option.Option.Some(tokens.TokenKind.Pipe) }
    if c == ";" { return option.Option.Some(tokens.TokenKind.Semicolon) }
    option.Option.None
}

pub fn lex(source: String) -> result.Result[[tokens.Token], String] {
    var tok_list = []
    let src_len = len(source)
    var pos = 0
    var line = 1
    var col = 1

    while pos < src_len {
        let c = source[pos]

        // 1. Whitespace
        if c == " " || c == "\t" || c == "\r" {
            pos = pos + 1
            col = col + 1
            nil
        } else if c == "\n" {
            pos = pos + 1
            line = line + 1
            col = 1
            nil
        }
        // 2. Line comment: //
        else if c == "/" && pos + 1 < src_len && source[pos + 1] == "/" {
            pos = pos + 2
            col = col + 2
            while pos < src_len && source[pos] != "\n" {
                pos = pos + 1
                col = col + 1
            }
            nil
        }
        // 3. Block comment: /* ... */
        else if c == "/" && pos + 1 < src_len && source[pos + 1] == "*" {
            let start_line = line
            let start_col = col
            pos = pos + 2
            col = col + 2
            var depth = 1
            while pos < src_len && depth > 0 {
                if source[pos] == "/" && pos + 1 < src_len && source[pos + 1] == "*" {
                    depth = depth + 1
                    pos = pos + 2
                    col = col + 2
                } else if source[pos] == "*" && pos + 1 < src_len && source[pos + 1] == "/" {
                    depth = depth - 1
                    pos = pos + 2
                    col = col + 2
                } else if source[pos] == "\n" {
                    pos = pos + 1
                    line = line + 1
                    col = 1
                } else {
                    pos = pos + 1
                    col = col + 1
                }
            }
            if depth > 0 {
                return result.Result.Err("unterminated block comment starting at {start_line}:{start_col}")
            }
            nil
        }
        // 4. Identifiers and Keywords
        else if is_alpha(c) {
            let start_col = col
            let start_pos = pos
            var text = ""
            while pos < src_len && is_alphanumeric(source[pos]) {
                text = "{text}{source[pos]}"
                pos = pos + 1
                col = col + 1
            }
            let sp = span.new_span(line, start_col, start_pos, len(text))
            let kind = keyword_or_ident(text)
            push(tok_list, tokens.new_token(kind, sp, text))
            nil
        }
        // 5. Numbers
        else if is_digit(c) {
            let start_col = col
            let start_pos = pos
            var num_str = ""
            var is_float = false
            while pos < src_len && is_digit(source[pos]) {
                num_str = "{num_str}{source[pos]}"
                pos = pos + 1
                col = col + 1
            }
            // Check for float dot: e.g. 3.14 (not 3..5 or 3.method)
            if pos < src_len && source[pos] == "." && pos + 1 < src_len && is_digit(source[pos + 1]) {
                is_float = true
                num_str = "{num_str}."
                pos = pos + 1
                col = col + 1
                while pos < src_len && is_digit(source[pos]) {
                    num_str = "{num_str}{source[pos]}"
                    pos = pos + 1
                    col = col + 1
                }
            }
            let sp = span.new_span(line, start_col, start_pos, len(num_str))
            if is_float {
                push(tok_list, tokens.new_token(tokens.TokenKind.FloatLit(float(num_str)), sp, num_str))
            } else {
                push(tok_list, tokens.new_token(tokens.TokenKind.IntLit(int(num_str)), sp, num_str))
            }
            nil
        }
        // 6. String Literals
        else if c == "\"" {
            let start_col = col
            let start_pos = pos
            let start_line = line
            pos = pos + 1
            col = col + 1
            var str_val = ""
            var closed = false
            while pos < src_len && !closed {
                let ch = source[pos]
                if ch == "\"" {
                    closed = true
                    pos = pos + 1
                    col = col + 1
                } else if ch == "\\" && pos + 1 < src_len {
                    let esc = source[pos + 1]
                    if esc == "n" { str_val = "{str_val}\n" }
                    else if esc == "t" { str_val = "{str_val}\t" }
                    else if esc == "r" { str_val = "{str_val}\r" }
                    else if esc == "\"" { str_val = "{str_val}\"" }
                    else if esc == "\\" { str_val = "{str_val}\\" }
                    else if esc == "\{" { str_val = "{str_val}\{" }
                    else if esc == "\}" { str_val = "{str_val}\}" }
                    else { str_val = "{str_val}{esc}" }
                    pos = pos + 2
                    col = col + 2
                } else if ch == "\n" {
                    str_val = "{str_val}\n"
                    pos = pos + 1
                    line = line + 1
                    col = 1
                } else {
                    str_val = "{str_val}{ch}"
                    pos = pos + 1
                    col = col + 1
                }
            }
            if !closed {
                return result.Result.Err("unterminated string literal at {start_line}:{start_col}")
            }
            let sp = span.new_span(start_line, start_col, start_pos, pos - start_pos)
            push(tok_list, tokens.new_token(tokens.TokenKind.StringLit(str_val), sp, str_val))
            nil
        }
        // 7. Multi-character operators and Single-character operators
        else {
            let start_col = col
            let start_pos = pos
            let op2 = scan_2char_op(source, pos)
            match op2 {
                Option.Some(k2) => {
                    pos = pos + 2
                    col = col + 2
                    let sp = span.new_span(line, start_col, start_pos, 2)
                    let text = "{source[start_pos]}{source[start_pos + 1]}"
                    push(tok_list, tokens.new_token(k2, sp, text))
                    nil
                }
                Option.None => {
                    let op1 = scan_1char_op(c)
                    match op1 {
                        Option.Some(k1) => {
                            pos = pos + 1
                            col = col + 1
                            let sp = span.new_span(line, start_col, start_pos, 1)
                            push(tok_list, tokens.new_token(k1, sp, c))
                            nil
                        }
                        Option.None => {
                            return result.Result.Err("unexpected character `{c}` at {line}:{col}")
                        }
                    }
                }
            }
        }
    }

    let eof_sp = span.new_span(line, col, pos, 0)
    push(tok_list, tokens.new_token(tokens.TokenKind.Eof, eof_sp, ""))
    result.Result.Ok(tok_list)
}