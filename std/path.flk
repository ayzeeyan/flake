// Path manipulation. `import path`.
import option
import string

pub fn is_separator(ch: String) -> Bool {
    ch == "/" || ch == "\\"
}

pub fn normalize_separators(p: String) -> String {
    let parts = split(p, "\\")
    join(parts, "/")
}

pub fn join_path(a: String, b: String) -> String {
    if len(a) == 0 {
        return b
    }
    if len(b) == 0 {
        return a
    }
    let norm_a = normalize_separators(a)
    let norm_b = normalize_separators(b)
    let a_ends = ends_with(norm_a, "/")
    let b_starts = starts_with(norm_b, "/")
    if a_ends && b_starts {
        let sub_b = string.slice(norm_b, 1, len(norm_b))
        return "{norm_a}{sub_b}"
    }
    if !a_ends && !b_starts {
        return "{norm_a}/{norm_b}"
    }
    "{norm_a}{norm_b}"
}

pub fn is_absolute(p: String) -> Bool {
    let norm = normalize_separators(p)
    if starts_with(norm, "/") {
        return true
    }
    if len(norm) >= 2 {
        let second = string.char_at(norm, 1)
        if second == ":" {
            return true
        }
    }
    false
}

pub fn file_name(p: String) -> option.Option[String] {
    let norm = normalize_separators(p)
    let parts = split(norm, "/")
    var last_non_empty = ""
    for part in parts {
        if len(part) > 0 {
            last_non_empty = part
        }
    }
    if len(last_non_empty) == 0 {
        return Option.None
    }
    Option.Some(last_non_empty)
}

pub fn parent(p: String) -> option.Option[String] {
    let norm = normalize_separators(p)
    let parts = split(norm, "/")
    var valid_parts = []
    for part in parts {
        if len(part) > 0 {
            push(valid_parts, part)
        }
    }
    if len(valid_parts) <= 1 {
        if starts_with(norm, "/") {
            return Option.Some("/")
        }
        return Option.None
    }
    pop(valid_parts)
    let res = join(valid_parts, "/")
    if starts_with(norm, "/") {
        return Option.Some("/{res}")
    }
    Option.Some(res)
}

pub fn extension(p: String) -> option.Option[String] {
    let name_opt = file_name(p)
    match name_opt {
        Option.Some(name) => {
            let dot_parts = split(name, ".")
            if len(dot_parts) > 1 {
                let ext = last(dot_parts)
                if len(ext) > 0 {
                    return Option.Some(ext)
                }
            }
            Option.None
        }
        Option.None => Option.None,
    }
}

pub fn normalize(p: String) -> String {
    let norm = normalize_separators(p)
    let parts = split(norm, "/")
    var stack = []
    for part in parts {
        if part == "" || part == "." {
            // skip
        } else if part == ".." {
            if len(stack) > 0 && last(stack) != ".." {
                pop(stack)
            } else {
                push(stack, part)
            }
        } else {
            push(stack, part)
        }
    }
    let res = join(stack, "/")
    if starts_with(norm, "/") {
        return "/{res}"
    }
    if len(res) == 0 {
        return "."
    }
    res
}
