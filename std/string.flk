// String helpers. `import string` (resolved from the `std/` directory).

pub fn is_blank(s: String) -> Bool {
    len(trim(s)) == 0
}

pub fn surround(s: String, left: String, right: String) -> String {
    "{left}{s}{right}"
}

pub fn replace(s: String, old: String, new: String) -> String {
    join(split(s, old), new)
}

pub fn repeat(s: String, n: Int) -> String {
    var out = ""
    var i = 0
    while i < n {
        out = "{out}{s}"
        i = i + 1
    }
    out
}

pub fn lines(s: String) -> [String] {
    split(s, "\n")
}

pub fn words(s: String) -> [String] {
    let parts = split(s, " ")
    var out = []
    for p in parts {
        if len(trim(p)) > 0 {
            push(out, p)
        }
    }
    out
}

pub fn pad_left(s: String, width: Int, pad: String) -> String {
    let slen = len(s)
    if slen >= width || len(pad) == 0 {
        return s
    }
    let needed = width - slen
    var prefix = ""
    while len(prefix) < needed {
        prefix = "{prefix}{pad}"
    }
    "{prefix}{s}"
}

pub fn pad_right(s: String, width: Int, pad: String) -> String {
    let slen = len(s)
    if slen >= width || len(pad) == 0 {
        return s
    }
    let needed = width - slen
    var suffix = ""
    while len(suffix) < needed {
        suffix = "{suffix}{pad}"
    }
    "{s}{suffix}"
}

pub fn slice(s: String, start: Int, end: Int) -> String {
    var out = ""
    var i = start
    while i < end && i < len(s) {
        out = "{out}{s[i]}"
        i = i + 1
    }
    out
}

pub fn char_at(s: String, idx: Int) -> String {
    s[idx]
}

pub fn to_upper(s: String) -> String {
    upper(s)
}

pub fn to_lower(s: String) -> String {
    lower(s)
}

pub fn trim_str(s: String) -> String {
    trim(s)
}


