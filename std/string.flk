// String helpers. `import string` (resolved from the `std/` directory).

pub fn is_blank(s: String) -> Bool {
    len(trim(s)) == 0
}

pub fn surround(s: String, left: String, right: String) -> String {
    "{left}{s}{right}"
}

pub fn replace(s: String, old: String, new: String) -> String {
    join(split(s, old), new)
}

pub fn repeat(s: String, n: Int) -> String {
    var out = ""
    var i = 0
    while i < n {
        out = "{out}{s}"
        i = i + 1
    }
    out
}

pub fn lines(s: String) -> [String] {
    split(s, "\n")
}

pub fn words(s: String) -> [String] {
    let parts = split(s, " ")
    var out = []
    for p in parts {
        if len(trim(p)) > 0 {
            push(out, p)
        }
    }
    out
}

pub fn pad_left(s: String, width: Int, pad: String) -> String {
    let slen = len(s)
    if slen >= width || len(pad) == 0 {
        return s
    }
    let needed = width - slen
    var prefix = ""
    while len(prefix) < needed {
        prefix = "{prefix}{pad}"
    }
    "{prefix}{s}"
}

pub fn pad_right(s: String, width: Int, pad: String) -> String {
    let slen = len(s)
    if slen >= width || len(pad) == 0 {
        return s
    }
    let needed = width - slen
    var suffix = ""
    while len(suffix) < needed {
        suffix = "{suffix}{pad}"
    }
    "{s}{suffix}"
}

pub fn slice(s: String, start: Int, end: Int) -> String {
    var out = ""
    var i = start
    while i < end && i < len(s) {
        out = "{out}{s[i]}"
        i = i + 1
    }
    out
}

pub fn char_at(s: String, idx: Int) -> String {
    s[idx]
}

pub fn to_upper(s: String) -> String {
    upper(s)
}

pub fn to_lower(s: String) -> String {
    lower(s)
}

pub fn trim_str(s: String) -> String {
    trim(s)
}

pub fn starts_with_str(s: String, prefix: String) -> Bool {
    starts_with(s, prefix)
}

pub fn ends_with_str(s: String, suffix: String) -> Bool {
    ends_with(s, suffix)
}

pub fn capitalize(s: String) -> String {
    if len(s) == 0 {
        return ""
    }
    let first_ch = upper(s[0])
    let rem = slice(s, 1, len(s))
    "{first_ch}{rem}"
}

pub fn reverse_str(s: String) -> String {
    var out = ""
    var i = len(s)
    while i > 0 {
        i = i - 1
        out = "{out}{s[i]}"
    }
    out
}

pub fn is_digit(ch: String) -> Bool {
    ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" ||
    ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9"
}

pub fn is_alpha(ch: String) -> Bool {
    let low = lower(ch)
    low == "a" || low == "b" || low == "c" || low == "d" || low == "e" ||
    low == "f" || low == "g" || low == "h" || low == "i" || low == "j" ||
    low == "k" || low == "l" || low == "m" || low == "n" || low == "o" ||
    low == "p" || low == "q" || low == "r" || low == "s" || low == "t" ||
    low == "u" || low == "v" || low == "w" || low == "x" || low == "y" || low == "z"
}

pub fn contains_str(s: String, sub: String) -> Bool {
    if len(sub) == 0 {
        return true
    }
    let parts = split(s, sub)
    len(parts) > 1
}

pub fn count_occurrences(s: String, sub: String) -> Int {
    if len(sub) == 0 {
        return 0
    }
    let parts = split(s, sub)
    len(parts) - 1
}

pub fn truncate(s: String, max_len: Int, suffix: String) -> String {
    if len(s) <= max_len {
        s
    } else {
        let keep = max_len - len(suffix)
        if keep <= 0 {
            suffix
        } else {
            "{slice(s, 0, keep)}{suffix}"
        }
    }
}



