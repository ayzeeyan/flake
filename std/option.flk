// Optional values. `import option`.

pub enum Option[T] {
    Some(T)
    None
}

pub fn is_some[T](o: Option[T]) -> Bool {
    match o {
        Option.Some(v) => true
        Option.None => false
    }
}

pub fn unwrap_or[T](o: Option[T], fallback: T) -> T {
    match o {
        Option.Some(v) => v
        Option.None => fallback
    }
}

pub fn is_none[T](o: Option[T]) -> Bool {
    match o {
        Option.Some(v) => false
        Option.None => true
    }
}

pub fn map_option[T, U](o: Option[T], f: fn(T) -> U) -> Option[U] {
    match o {
        Option.Some(v) => Option.Some(f(v))
        Option.None => Option.None
    }
}

pub fn filter_option[T](o: Option[T], pred: fn(T) -> Bool) -> Option[T] {
    match o {
        Option.Some(v) => if pred(v) { Option.Some(v) } else { Option.None }
        Option.None => Option.None
    }
}

pub fn zip_option(a: Option, b: Option) -> Option {
    match a {
        Option.Some(va) => match b {
            Option.Some(vb) => Option.Some([va, vb])
            Option.None => Option.None
        }
        Option.None => Option.None
    }
}

pub fn expect_some(o: Option, msg: String) -> dyn {
    match o {
        Option.Some(v) => v
        Option.None => {
            assert(false, msg)
            nil
        }
    }
}

pub fn and_then_option[T, U](o: Option[T], f: fn(T) -> Option[U]) -> Option[U] {
    match o {
        Option.Some(v) => f(v)
        Option.None => Option.None
    }
}

pub fn or_else_option[T](o: Option[T], fallback: fn() -> Option[T]) -> Option[T] {
    match o {
        Option.Some(v) => Option.Some(v)
        Option.None => fallback()
    }
}

pub fn is_some_and[T](o: Option[T], pred: fn(T) -> Bool) -> Bool {
    match o {
        Option.Some(v) => pred(v)
        Option.None => false
    }
}

pub fn unwrap_or_else[T](o: Option[T], f: fn() -> T) -> T {
    match o {
        Option.Some(v) => v
        Option.None => f()
    }
}

pub fn flatten_option(o: Option) -> Option {
    match o {
        Option.Some(Option.Some(v)) => Option.Some(v)
        Option.Some(Option.None) => Option.None
        Option.Some(v) => Option.Some(v)
        Option.None => Option.None
    }
}


