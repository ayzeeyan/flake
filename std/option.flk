// Optional values. `import option`.

pub enum Option {
    Some(dyn)
    None
}

pub fn is_some(o: Option) -> Bool {
    match o {
        Option.Some(v) => true
        Option.None => false
    }
}

pub fn unwrap_or(o: Option, fallback: dyn) -> dyn {
    match o {
        Option.Some(v) => v
        Option.None => fallback
    }
}
