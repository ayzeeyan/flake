// Result-style errors. `import result`.

pub enum Result {
    Ok(dyn)
    Err(String)
}

pub fn is_ok(r: Result) -> Bool {
    match r {
        Result.Ok(v) => true
        Result.Err(m) => false
    }
}

pub fn is_err(r: Result) -> Bool {
    match r {
        Result.Ok(v) => false
        Result.Err(m) => true
    }
}

pub fn unwrap_or(r: Result, fallback: dyn) -> dyn {
    match r {
        Result.Ok(v) => v
        Result.Err(m) => fallback
    }
}

pub fn error_or(r: Result, fallback: String) -> String {
    match r {
        Result.Ok(v) => fallback
        Result.Err(m) => m
    }
}

pub fn unwrap(r: Result) -> dyn / panic {
    match r {
        Result.Ok(v) => v
        Result.Err(m) => {
            assert(false, m)
            nil
        }
    }
}

pub fn map_result(r: Result, f: fn(dyn) -> dyn) -> Result {
    match r {
        Result.Ok(v) => Result.Ok(f(v))
        Result.Err(m) => Result.Err(m)
    }
}

pub fn map_err(r: Result, f: fn(String) -> String) -> Result {
    match r {
        Result.Ok(v) => Result.Ok(v)
        Result.Err(m) => Result.Err(f(m))
    }
}

pub fn and_then(r: Result, f: fn(dyn) -> Result) -> Result {
    match r {
        Result.Ok(v) => f(v)
        Result.Err(m) => Result.Err(m)
    }
}

pub fn is_ok_and(r: Result, pred: fn(dyn) -> Bool) -> Bool {
    match r {
        Result.Ok(v) => pred(v)
        Result.Err(m) => false
    }
}

pub fn is_err_and(r: Result, pred: fn(String) -> Bool) -> Bool {
    match r {
        Result.Ok(v) => false
        Result.Err(m) => pred(m)
    }
}

pub fn expect_ok(r: Result, msg: String) -> dyn / panic {
    match r {
        Result.Ok(v) => v
        Result.Err(m) => {
            assert(false, "{msg}: {m}")
            nil
        }
    }
}

pub fn flatten_result(r: Result) -> Result {
    match r {
        Result.Ok(Result.Ok(v)) => Result.Ok(v)
        Result.Ok(Result.Err(m)) => Result.Err(m)
        Result.Ok(v) => Result.Ok(v)
        Result.Err(m) => Result.Err(m)
    }
}

pub fn or_else_result(r: Result, f: fn(String) -> Result) -> Result {
    match r {
        Result.Ok(v) => Result.Ok(v)
        Result.Err(m) => f(m)
    }
}

pub fn unwrap_or_else(r: Result, f: fn(String) -> dyn) -> dyn {
    match r {
        Result.Ok(v) => v
        Result.Err(m) => f(m)
    }
}

pub fn inspect_ok(r: Result, f: fn(dyn)) -> Result {
    match r {
        Result.Ok(v) => {
            f(v)
            Result.Ok(v)
        }
        Result.Err(m) => Result.Err(m)
    }
}

pub fn inspect_err(r: Result, f: fn(String)) -> Result {
    match r {
        Result.Ok(v) => Result.Ok(v)
        Result.Err(m) => {
            f(m)
            Result.Err(m)
        }
    }
}


