// List helpers. `import list` (resolved from the `std/` directory).

pub fn is_empty(xs) -> Bool {
    len(xs) == 0
}

pub fn rest(xs) -> [dyn] {
    var out = []
    var i = 1
    while i < len(xs) {
        push(out, xs[i])
        i = i + 1
    }
    out
}

pub fn reverse(xs) -> [dyn] {
    var out = []
    var i = len(xs)
    while i > 0 {
        i = i - 1
        push(out, xs[i])
    }
    out
}

pub fn concat(a, b) -> [dyn] {
    var out = []
    for x in a {
        push(out, x)
    }
    for x in b {
        push(out, x)
    }
    out
}

pub fn take(xs, n: Int) -> [dyn] {
    var out = []
    var i = 0
    while i < n && i < len(xs) {
        push(out, xs[i])
        i = i + 1
    }
    out
}

pub fn drop(xs, n: Int) -> [dyn] {
    var out = []
    var i = n
    while i < len(xs) {
        push(out, xs[i])
        i = i + 1
    }
    out
}

pub fn sum(xs) -> Int {
    var s = 0
    for x in xs {
        s = s + x
    }
    s
}

pub fn index_of(xs, target: dyn) -> Int {
    var i = 0
    while i < len(xs) {
        if xs[i] == target {
            return i
        }
        i = i + 1
    }
    -1
}

pub fn contains_item(xs, item: dyn) -> Bool {
    index_of(xs, item) >= 0
}

pub fn map(xs, f: fn(dyn) -> dyn) -> [dyn] {
    var out = []
    for x in xs {
        push(out, f(x))
    }
    out
}

pub fn filter(xs, pred: fn(dyn) -> Bool) -> [dyn] {
    var out = []
    for x in xs {
        if pred(x) {
            push(out, x)
        }
    }
    out
}

pub fn fold(xs, init: dyn, f: fn(dyn, dyn) -> dyn) -> dyn {
    var acc = init
    for x in xs {
        acc = f(acc, x)
    }
    acc
}

pub fn any(xs, pred: fn(dyn) -> Bool) -> Bool {
    for x in xs {
        if pred(x) {
            return true
        }
    }
    false
}

pub fn all(xs, pred: fn(dyn) -> Bool) -> Bool {
    for x in xs {
        if !pred(x) {
            return false
        }
    }
    true
}

pub fn flatten(xss) -> [dyn] {
    var out = []
    for sub in xss {
        for item in sub {
            push(out, item)
        }
    }
    out
}

pub fn min_item(xs) -> dyn {
    if len(xs) == 0 {
        return nil
    }
    var m = xs[0]
    var i = 1
    while i < len(xs) {
        if xs[i] < m {
            m = xs[i]
        }
        i = i + 1
    }
    m
}

pub fn max_item(xs) -> dyn {
    if len(xs) == 0 {
        return nil
    }
    var m = xs[0]
    var i = 1
    while i < len(xs) {
        if xs[i] > m {
            m = xs[i]
        }
        i = i + 1
    }
    m
}

pub fn zip(xs, ys) -> [dyn] {
    var out = []
    var i = 0
    while i < len(xs) && i < len(ys) {
        push(out, [xs[i], ys[i]])
        i = i + 1
    }
    out
}

pub fn unzip(pairs) -> [dyn] {
    var firsts = []
    var seconds = []
    for pair in pairs {
        push(firsts, pair[0])
        push(seconds, pair[1])
    }
    [firsts, seconds]
}

pub fn take_while(xs, pred: fn(dyn) -> Bool) -> [dyn] {
    var out = []
    for x in xs {
        if !pred(x) {
            return out
        }
        push(out, x)
    }
    out
}

pub fn drop_while(xs, pred: fn(dyn) -> Bool) -> [dyn] {
    var out = []
    var dropping = true
    for x in xs {
        if dropping && pred(x) {
            continue
        }
        dropping = false
        push(out, x)
    }
    out
}

pub fn find_index(xs, pred: fn(dyn) -> Bool) -> Int {
    var i = 0
    while i < len(xs) {
        if pred(xs[i]) {
            return i
        }
        i = i + 1
    }
    -1
}

pub fn unique(xs) -> [dyn] {
    var out = []
    for x in xs {
        if !contains_item(out, x) {
            push(out, x)
        }
    }
    out
}

pub fn count_where(xs, pred: fn(dyn) -> Bool) -> Int {
    var count = 0
    for x in xs {
        if pred(x) {
            count = count + 1
        }
    }
    count
}

pub fn repeat_item(item: dyn, n: Int) -> [dyn] {
    var out = []
    var i = 0
    while i < n {
        push(out, item)
        i = i + 1
    }
    out
}

pub fn chunk(xs, size: Int) -> [dyn] {
    if size <= 0 {
        return []
    }
    var out = []
    var current = []
    for x in xs {
        push(current, x)
        if len(current) == size {
            push(out, current)
            current = []
        }
    }
    if len(current) > 0 {
        push(out, current)
    }
    out
}

