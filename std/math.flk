// Integer helpers. `import math` from `std/` unless a sibling `math.flk` exists.

pub fn clamp(x: Int, lo: Int, hi: Int) -> Int {
    max(lo, min(x, hi))
}

pub fn pow(base: Int, exp: Int) -> Int {
    var r = 1
    var i = 0
    while i < exp {
        r = r * base
        i = i + 1
    }
    r
}

pub fn sign(x: Int) -> Int {
    if x > 0 {
        1
    } else if x < 0 {
        -1
    } else {
        0
    }
}

pub fn gcd(a: Int, b: Int) -> Int {
    var x = abs(a)
    var y = abs(b)
    while y != 0 {
        let t = y
        y = x % y
        x = t
    }
    x
}

pub fn lcm(a: Int, b: Int) -> Int {
    if a == 0 || b == 0 {
        return 0
    }
    abs(a * b) / gcd(a, b)
}

pub fn factorial(n: Int) -> Int {
    if n <= 1 {
        return 1
    }
    var res = 1
    var i = 2
    while i <= n {
        res = res * i
        i = i + 1
    }
    res
}

pub fn is_even(n: Int) -> Bool {
    n % 2 == 0
}

pub fn is_odd(n: Int) -> Bool {
    n % 2 != 0
}

pub fn abs_val(x: Int) -> Int {
    abs(x)
}

pub fn min_val(a: Int, b: Int) -> Int {
    min(a, b)
}

pub fn max_val(a: Int, b: Int) -> Int {
    max(a, b)
}

pub fn is_prime(n: Int) -> Bool {
    if n <= 1 {
        return false
    }
    if n <= 3 {
        return true
    }
    if n % 2 == 0 || n % 3 == 0 {
        return false
    }
    var i = 5
    while i * i <= n {
        if n % i == 0 || n % (i + 2) == 0 {
            return false
        }
        i = i + 6
    }
    true
}

pub fn sum_range(start: Int, end: Int) -> Int {
    var s = 0
    var i = start
    while i < end {
        s = s + i
        i = i + 1
    }
    s
}

pub fn product(xs) -> Int {
    var p = 1
    for x in xs {
        p = p * x
    }
    p
}

pub fn mean(xs) -> Int {
    if len(xs) == 0 {
        return 0
    }
    var s = 0
    for x in xs {
        s = s + x
    }
    s / len(xs)
}

pub fn square(x: Int) -> Int {
    x * x
}

pub fn cube(x: Int) -> Int {
    x * x * x
}

pub fn div_ceil(a: Int, b: Int) -> Int {
    if b == 0 {
        0
    } else {
        (a + b - 1) / b
    }
}

pub fn in_range(x: Int, lo: Int, hi: Int) -> Bool {
    x >= lo && x < hi
}


